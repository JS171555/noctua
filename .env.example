# Valores públicos usados pelo cliente no navegador durante o build.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Valores server-side usados pelas funções/autenticação no servidor.
# Configure os mesmos valores no Vercel para Production, Preview e Development.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Opcional: somente se forem usadas operações administrativas confiáveis no servidor.
# Nunca use o prefixo VITE_ nesta chave.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: necessário apenas para comandos Drizzle/migrações, não para servir o app.
DATABASE_URL=
